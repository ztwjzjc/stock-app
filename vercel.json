{
  "version": 2,
  "rewrites": [
    { "source": "/api/quote/:code", "destination": "/api/quote/[code]" },
    { "source": "/api/finance/:code", "destination": "/api/finance/[code]" },
    { "source": "/api/history/:code", "destination": "/api/history/[code]" },
    { "source": "/api/search/:keyword", "destination": "/api/search/[keyword]" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" }
      ]
    }
  ]
}
